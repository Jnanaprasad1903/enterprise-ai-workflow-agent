# ===================================================
# Enterprise AI Workflow Agent - Environment Variables
# ===================================================

# Google Gemini API Key (Required for AI Agent & Embeddings)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# SQLite Database File Path (relative to project root or absolute)
DATABASE_PATH=data/enterprise.db

# Vector Store Path (for persistent ChromaDB embeddings)
CHROMA_PERSIST_DIR=data/chroma_db

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash
